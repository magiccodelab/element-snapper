{
  "manifest_version": 3,
  "name": "Element Snapper",
  "version": "0.1.0",
  "description": "Click any element, copy its HTML + CSS for AI prompts",
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "action": {
    "default_title": "Element Snapper - Pick an element"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
