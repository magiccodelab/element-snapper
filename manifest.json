{
  "manifest_version": 3,
  "name": "Element Snapper",
  "version": "0.1.0",
  "description": "Click any element, copy its HTML + CSS for AI prompts",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "action": {
    "default_title": "Element Snapper - Pick an element"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
